{
    # Aktifkan metrics globally; endpoint eksplisit ada di bawah.
    metrics {
        per_host
    }
}

# Jellyfin Private — Tailscale only
jellyfin-private.home.arpa {
    tls internal
    reverse_proxy 192.168.18.13:8096
}

# Jellyfin Shared — internal / Tailscale
jellyfin-shared.home.arpa {
    tls internal
    reverse_proxy 192.168.18.26:8096
}

cloud.home.arpa {
    tls internal
    reverse_proxy 192.168.18.19:8090
}

ha.home.arpa {
    tls internal
    reverse_proxy 192.168.18.15:8123
}

# Management / Tailscale only
grafana.home.arpa {
    tls internal
    reverse_proxy 192.168.18.16:3000
}

# Management / Tailscale only
git.home.arpa {
    tls internal
    reverse_proxy 192.168.18.17:3000
}

# Endpoint metrics untuk Prometheus nanti
http://metrics.home.arpa {
    metrics
}

# Backend sementara untuk verifikasi P04
test.home.arpa {
    tls internal
    reverse_proxy 127.0.0.1:5000
}
# Domain nyata — public CA via Cloudflare DNS-01
test.rafifdzaky.com {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }

    reverse_proxy 127.0.0.1:5000
}

# SparkyFitness - internal only (no public A record, no tunnel). Public cert via DNS-01.
fit.rafifdzaky.com {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    reverse_proxy 192.168.18.27:3004
}

# Portfolio - public via Cloudflare Tunnel (cloudflared on this host -> 127.0.0.1:8081).
# Released by portfolio repo CI into /srv/www/portfolio. Reference: portfolio/docs/SECURITY.md
http://rafifdzaky.com:8081, http://www.rafifdzaky.com:8081 {
    bind 127.0.0.1 ::1

    @www host www.rafifdzaky.com
    redir @www https://rafifdzaky.com{uri} permanent

    root * /srv/www/portfolio/current
    encode zstd gzip

    # `curl rafifdzaky.com` gets the résumé as coloured terminal text.
    @cli {
        path /
        header_regexp User-Agent ^(curl|Wget|HTTPie|xh)/
    }
    rewrite @cli /cli.txt
    header / Vary User-Agent

    file_server

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        X-Hire-Me "rafifdzaky27@gmail.com"
        X-Served-By "homelab, via Cloudflare Tunnel and Caddy"
        -Server
    }

    @hashed path /_astro/*
    header @hashed Cache-Control "public, max-age=31536000, immutable"

    # never serve dotfiles, even if one ends up in a release by accident
    @dotfiles path */.*
    respond @dotfiles 404

    handle_errors {
        rewrite * /404.html
        file_server
    }
}
