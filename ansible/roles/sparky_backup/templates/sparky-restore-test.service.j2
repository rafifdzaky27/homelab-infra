[Unit]
Description=SparkyFitness weekly restore test
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=2h
StartLimitBurst=4

[Service]
Type=oneshot
User={{ sparky_user }}
EnvironmentFile={{ sparky_backup_conf_dir }}/env
ExecStartPre=/bin/bash {{ sparky_root }}/backup/backup.sh
ExecStart=/bin/bash {{ sparky_root }}/backup/restore-test.sh
{% if sparky_restore_test_ping_url %}
ExecStartPost=/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null {{ sparky_restore_test_ping_url }}
{% endif %}
Restart=on-failure
RestartSec=10min
Nice=10
