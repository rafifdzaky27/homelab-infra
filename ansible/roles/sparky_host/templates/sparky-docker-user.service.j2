[Unit]
Description=Restrict SparkyFitness published port to the Caddy proxy (DOCKER-USER)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/bin/bash -c '/usr/sbin/iptables -C DOCKER-USER ! -s {{ sparky_proxy_ip }} -p tcp -m conntrack --ctorigdstport {{ sparky_frontend_port }} --ctdir ORIGINAL -j DROP 2>/dev/null || /usr/sbin/iptables -I DOCKER-USER ! -s {{ sparky_proxy_ip }} -p tcp -m conntrack --ctorigdstport {{ sparky_frontend_port }} --ctdir ORIGINAL -j DROP'
ExecStop=/bin/bash -c '/usr/sbin/iptables -D DOCKER-USER ! -s {{ sparky_proxy_ip }} -p tcp -m conntrack --ctorigdstport {{ sparky_frontend_port }} --ctdir ORIGINAL -j DROP 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
