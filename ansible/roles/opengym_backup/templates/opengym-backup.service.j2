[Unit]
Description=openGym nightly backup (data/ -> restic)
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=2h
StartLimitBurst=4

[Service]
Type=oneshot
EnvironmentFile={{ opengym_backup_conf_dir }}/env
ExecStart=/bin/bash {{ opengym_root }}/backup/backup.sh
{% if opengym_backup_ping_url %}
ExecStartPost=/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null {{ opengym_backup_ping_url }}
{% endif %}
Restart=on-failure
RestartSec=10min
Nice=10
IOSchedulingClass=idle
