# Managed by Ansible (roles/opengym_host). Do not edit on the host.
# Based on upstream docker-compose.yml at {{ opengym_version }}, with pinned images, no build
# sections, no published ports and cloudflared added. Nothing listens on the LAN: the only way
# in is the Cloudflare Tunnel, which reaches web:80 over the compose network.
x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  # One-time download of the exercise images and GIFs (~140 MB), skipped once present.
  # The media is third-party content (see upstream NOTICE.md); it is fetched, not redistributed.
  media:
    image: {{ opengym_media_image }}
    logging: *logging
    volumes:
      - ./media/img:/out/img
      - ./media/gif:/out/gif
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        if [ -z "$$(ls -A /out/img 2>/dev/null)" ]; then
          git clone --depth 1 https://github.com/hasaneyldrm/exercises-dataset /tmp/ds
          cp /tmp/ds/images/*.jpg /out/img/ && cp /tmp/ds/videos/*.gif /out/gif/
          echo "exercise media ready: $$(ls /out/img | wc -l) images"
        else
          echo "exercise media already present"
        fi
    restart: "no"

  api:
    image: ghcr.io/duartesantos8/opengym-api:{{ opengym_version }}
    logging: *logging
    restart: unless-stopped
    env_file: api.env
    environment:
      PORT: "3000"
      DATA_DIR: /data
      # Only web can reach the api, and web overwrites the forwarded headers.
      TRUST_PROXY: "1"
    volumes:
      - ./data:/data
    networks: [opengym]

  web:
    image: ghcr.io/duartesantos8/opengym-web:{{ opengym_version }}
    logging: *logging
    restart: unless-stopped
    depends_on:
      media:
        condition: service_completed_successfully
      api:
        condition: service_started
    environment:
      NGINX_PORT: "80"
      BACKEND: api
      PORT: "3000"
      RESOLVER: 127.0.0.11
      # Cloudflare really is in front, so let its client-IP header through to the activity log.
      CF_CONNECTING_IP: "$$http_cf_connecting_ip"
      MEDIA_UPLOAD_MAX: 48m
    volumes:
      - ./media/img:/usr/share/nginx/html/img:ro
      - ./media/gif:/usr/share/nginx/html/gif:ro
    networks: [opengym]

  # Remotely-managed tunnel (token). Public hostname in the dashboard: {{ opengym_domain }} -> http://web:80
  cloudflared:
    image: {{ opengym_cloudflared_image }}
    logging: *logging
    restart: unless-stopped
    command: tunnel --no-autoupdate run
    environment:
      TUNNEL_TOKEN: ${TUNNEL_TOKEN}
    depends_on:
      - web
    networks: [opengym]

networks:
  opengym:
